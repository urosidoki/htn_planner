(:domain aaa_combat
    (:method (combat_tick ?inp_npc ?inp_enemy ?inp_distance)
        (critical_retreat
            (and (health ?inp_npc ?hp) (<= ?hp 20)
                 (retreat_route ?inp_npc ?route))
            ((!remember_enemy ?inp_npc ?inp_enemy)
             (!throw_smoke ?inp_npc)
             (!retreat_via ?inp_npc ?route))
        )
        (melee
            (and (< ?inp_distance 8))
            ((melee_tick ?inp_npc ?inp_enemy))
        )
        (ranged
            (and (>= ?inp_distance 8))
            ((ranged_tick ?inp_npc ?inp_enemy ?inp_distance))
        )
    )

    (:method (melee_tick ?inp_npc ?inp_enemy)
        (parry_counter
            (and (enemy_attacking ?inp_enemy) (stamina ?inp_npc ?amount)
                 (>= ?amount 30) (weapon_equipped ?inp_npc melee))
            ((!face_enemy ?inp_npc ?inp_enemy)
             (!parry_attack ?inp_npc ?inp_enemy)
             (!counter_attack ?inp_npc ?inp_enemy))
        )
        (heavy_strike
            (and (enemy_staggered ?inp_enemy) (stamina ?inp_npc ?amount)
                 (>= ?amount 45) (weapon_equipped ?inp_npc melee))
            ((!heavy_melee_attack ?inp_npc ?inp_enemy))
        )
        (quick_strike
            (and (weapon_equipped ?inp_npc melee))
            ((!face_enemy ?inp_npc ?inp_enemy)
             (!quick_melee_attack ?inp_npc ?inp_enemy))
        )
        (draw_melee
            (and (weapon_available ?inp_npc melee))
            ((!switch_weapon ?inp_npc melee)
             (!quick_melee_attack ?inp_npc ?inp_enemy))
        )
        (improvised_defense
            ()
            ((!dodge_enemy ?inp_npc ?inp_enemy)
             (!improvised_melee_attack ?inp_npc ?inp_enemy))
        )
    )

    (:method (ranged_tick ?inp_npc ?inp_enemy ?inp_distance)
        (flank_suppressed_target
            (and (enemy_suppressed ?inp_enemy) (flank_route ?inp_npc ?inp_enemy ?route)
                 (weapon_equipped ?inp_npc ranged) (ammo ?inp_npc ?count)
                 (> ?count 0))
            ((!follow_flank_route ?inp_npc ?route)
             (!aim_at ?inp_npc ?inp_enemy)
             (!fire_burst ?inp_npc ?inp_enemy))
        )
        (take_cover_and_fire
            (and (under_fire ?inp_npc) (cover_available ?inp_npc ?cover)
                 (not (cover_compromised ?cover))
                 (weapon_equipped ?inp_npc ranged) (ammo ?inp_npc ?count)
                 (> ?count 0))
            ((!move_to_cover ?inp_npc ?cover)
             (!peek_from_cover ?inp_npc ?inp_enemy)
             (!fire_controlled_burst ?inp_npc ?inp_enemy))
        )
        (reload_in_cover
            (and (weapon_equipped ?inp_npc ranged) (ammo ?inp_npc 0)
                 (reserve_ammo ?inp_npc ?count) (> ?count 0)
                 (cover_available ?inp_npc ?cover))
            ((!move_to_cover ?inp_npc ?cover)
             (!reload_weapon ?inp_npc ranged))
        )
        (reload
            (and (weapon_equipped ?inp_npc ranged) (ammo ?inp_npc 0)
                 (reserve_ammo ?inp_npc ?count) (> ?count 0))
            ((!reload_weapon ?inp_npc ranged))
        )
        (precision_shot
            (and (weapon_equipped ?inp_npc ranged) (ammo ?inp_npc ?count)
                 (> ?count 0) (>= ?inp_distance 30) (clear_shot ?inp_npc ?inp_enemy))
            ((!aim_at ?inp_npc ?inp_enemy)
             (!fire_precision_shot ?inp_npc ?inp_enemy))
        )
        (controlled_burst
            (and (weapon_equipped ?inp_npc ranged) (ammo ?inp_npc ?count)
                 (> ?count 0) (clear_shot ?inp_npc ?inp_enemy))
            ((!aim_at ?inp_npc ?inp_enemy)
             (!fire_controlled_burst ?inp_npc ?inp_enemy))
        )
        (switch_to_ranged
            (and (weapon_available ?inp_npc ranged) (ammo ?inp_npc ?count)
                 (> ?count 0))
            ((!switch_weapon ?inp_npc ranged)
             (!aim_at ?inp_npc ?inp_enemy)
             (!fire_controlled_burst ?inp_npc ?inp_enemy))
        )
        (close_distance
            (and (advance_route ?inp_npc ?inp_enemy ?route))
            ((!advance_under_cover ?inp_npc ?route)
             (!suppress_enemy ?inp_npc ?inp_enemy))
        )
        (defensive_fallback
            ()
            ((!track_enemy ?inp_npc ?inp_enemy)
             (!seek_cover ?inp_npc))
        )
    )
)
