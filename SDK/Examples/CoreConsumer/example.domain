(:domain PackageCoreConsumer top_level_domain

    (:method (run_backtracking ?inp_depth) top_level_method
        (step (and (> ?inp_depth 0))
            ((!step ?inp_depth) (run_backtracking (-- ?inp_depth)) (!step ?inp_depth)))
        (done () ((!leaf))))

    (:constants (true 1) (false 0))

    (:method (boolean_condition) top_level_method
        (branch (and (call condition_value)) ((!checked))))

    (:method (run) top_level_method
        (branch
            (and
                (== @true 1)
                (== 0 @false)
                (!= 0 false)
                (!= true 0)
            )
            (
                (!step "one")
                (!step "two")
                (!step "three")
            )
        )
    )

    (:method (run_small) top_level_method
        (branch
            ()
            (
                (!step "small-one")
                (!step "small-two")
            )
        )
    )

    (:method (always_fail) top_level_method
        (never
            (and
                (== 1 2)
            )
            (
                (!unexpected)
            )
        )
    )
)
